    {
      "parameters": {
        "jsCode": "// COMPLIANCE - DESTRUCCIÓN BINARIA\n// Se descartan TODOS los payloads binarios (nota de voz del cliente y audio TTS).\n// Solo sobreviven metadatos mínimos, sin audio, para la auditoría.\nlet respuesta = '';\nlet estado = 'contingencia_audio_no_valido';\ntry {\n  respuesta = $('Contención 200 caracteres').first().json.respuesta;\n  estado = 'respondido_por_voz';\n} catch (e) {}\n\nconst msg = $('Telegram Trigger').first().json.message || {};\nlet transcripcion = '';\ntry { transcripcion = $('OpenAI Whisper (STT)').first().json.text || ''; } catch (e) {}\n\n// Se devuelven items SOLO con json: n8n no propaga ninguna propiedad \"binary\".\nreturn [{\n  json: {\n    chat_id: msg.chat ? msg.chat.id : null,\n    duracion_audio_seg: msg.voice ? msg.voice.duration : null,\n    transcripcion,\n    respuesta,\n    caracteres_tts: respuesta.length,\n    estado,\n    binarios_destruidos: true,\n    procesado: $now.toISO(),\n  },\n}];"
      },
      "id": "8049ac7e-4095-5e9a-8cea-28137e9e5fb3",
      "name": "Compliance - Destrucción Binaria",
